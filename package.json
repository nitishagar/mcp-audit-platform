{
  "name": "mcp-audit-platform",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitishagar/mcp-audit-platform.git"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "copy-guard": "bash scripts/copy-guard.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.10.10",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
